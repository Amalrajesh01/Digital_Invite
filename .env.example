# ── Core ────────────────────────────────────────────────────────────────
# Public origin of the app (used for share links, QR codes and OG tags)
APP_URL=http://localhost:3000
# 32+ random characters. Used to sign short-lived tokens (magic links, upload tickets).
APP_SECRET=change-me-to-a-long-random-string-please-0123456789

# ── Database ────────────────────────────────────────────────────────────
# Leave empty in development: an embedded Postgres (PGlite) is stored in ./.data/pg
# For Supabase / any Postgres in production, set the pooled connection string:
DATABASE_URL=
# Optional: where the embedded Postgres keeps its files (default ./.data/pg) — e.g. to run a second copy of the app.
PGLITE_DIR=

# ── Storage ─────────────────────────────────────────────────────────────
# "local" stores files under ./storage (fine on a VPS with a persistent disk — back it up).
# "s3" targets AWS S3, Cloudflare R2 or any S3-compatible bucket.
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-south-1). R2/MinIO: set S3_ENDPOINT and S3_REGION=auto.
# Existing local files can be copied over with:  npm run storage:sync
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL for public objects (R2 custom domain / r2.dev)
S3_PUBLIC_BASE_URL=

# ── Cloudinary: where invitation photographs live and are delivered from (see docs/CLOUDINARY.md) ──
# Dashboard → Settings → API Keys (cloud name is on the dashboard home). Leave empty in development: photographs then stay on the
# STORAGE_DRIVER store above. The API secret is server-side only: never put it in a NEXT_PUBLIC_ variable or in code.
# Check the connection with:  npm run cloudinary:check
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the top-level folder of everything this app uploads (lowercase), default sbl-invites
CLOUDINARY_FOLDER=
# Optional safety nets for the migration tool, on top of the built-in protected names and any invitation marked "pinned":
# extra names to skip (comma-separated) and exact invitation ids to skip (comma-separated)
CLOUDINARY_EXCLUDE_NAMES=
CLOUDINARY_EXCLUDE_WEDDING_IDS=

# ── Email (optional). Without a key, emails are recorded in the outbox instead. ──
RESEND_API_KEY=
EMAIL_FROM="StackBridge Invites <invites@example.com>"

# ── Scheduled jobs ─────────────────────────────────────────────────────
# Protects /api/cron (queued emails, time-capsule notifications). Vercel Cron sends it automatically.
CRON_SECRET=

# ── Seed ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@stackbridgelab.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123
