[Unit]
Description=StackBridge Invites (Next.js)
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/stackbridge-invites
EnvironmentFile=/home/deploy/apps/stackbridge-invites/.env.production
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 8104
Restart=always
RestartSec=3
MemoryHigh=600M
MemoryMax=800M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
