NODE_ENV=production
APP_URL=http://65.108.245.110:8004
APP_SECRET=__generated__
CRON_SECRET=__generated__

# PostgreSQL on this server (created by deploy/setup-db.sh)
DATABASE_URL=postgres://stackbridge_user:__password__@127.0.0.1:5432/stackbridge_invites

# Media: "local" now; switch to "s3" after adding the AWS values, then run `npm run storage:sync`
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/home/deploy/apps/stackbridge-invites/storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM="StackBridge Invites <invites@example.com>"

# First-run seeding
SEED_ADMIN_EMAIL=admin@stackbridgelab.com
SEED_ADMIN_PASSWORD=__generated__
SEED_ADMIN_NAME=Amal
